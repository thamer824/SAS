# ---------------------------------------------------------------------------
# Mounaqasat — configuration
# Copy to `.env.local` and fill in what you need. Everything has a sane default
# except APP_SECRET, which you should always set in production.
# ---------------------------------------------------------------------------

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./data/mounaqasat.db

# Public origin, used in emails, ICS feeds and web-push payloads.
APP_URL=http://localhost:3000

# Secret used to sign session cookies and feed tokens. 32+ random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-in-production-please-0000000000000000

# --- TUNEPS source ---------------------------------------------------------
TUNEPS_API_BASE=https://www.tuneps.tn/api2/portail
# TUNEPS serves an incomplete certificate chain; set to 0 only if your Node
# install cannot validate it (the data is public, read-only).
TUNEPS_TLS_STRICT=0
# Polite pacing between upstream requests (ms) and detail-enrichment budget.
TUNEPS_REQUEST_DELAY_MS=350
TUNEPS_DETAIL_BUDGET=400

# --- Email (digests + instant alerts) --------------------------------------
# Leave SMTP_HOST empty to use the "outbox" transport, which writes .eml files
# to ./data/outbox instead of sending. Perfect for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mounaqasat <alertes@mounaqasat.tn>"

# --- Web push (browser notifications) --------------------------------------
# Generate a keypair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertes@mounaqasat.tn

# --- Telegram (instant alerts, very popular with TN suppliers) -------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
